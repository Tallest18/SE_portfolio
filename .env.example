# Password used to log into /admin. Change this before deploying.
ADMIN_PASSWORD=changeme123

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-long-random-string

# Public URL of the deployed site, e.g. https://blessing.dev
# Used for link previews (LinkedIn/X cards) and search metadata.
# Optional: falls back to the "portfolio" link set in /admin.
SITE_URL=
